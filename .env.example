# Banco interno do Docker Compose
MYSQL_DATABASE=bonanca
MYSQL_USER=bonanca
MYSQL_PASSWORD=troque-por-um-segredo-forte
MYSQL_ROOT_PASSWORD=troque-por-um-segredo-root-forte
DATABASE_URL=mysql://bonanca:troque-por-um-segredo-forte@db:3306/bonanca

# Sessões e primeiro acesso
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
SEED_ADMIN_EMAIL=admin@bonanca.local
SEED_ADMIN_PASSWORD=troque-por-uma-senha-forte

# Comunicação interna dos microserviços; gere valores diferentes, longos e aleatórios.
PESAGEM_SERVICE_TOKEN=troque-por-um-token-interno-de-pesagem
BALANCA_SERVICE_TOKEN=troque-por-um-token-interno-da-balanca
# As URLs abaixo já apontam aos nomes da rede Docker; não exponha as portas 8080 externamente.
PESAGEM_SERVICE_URL=http://pesagem:8080
BALANCA_SERVICE_URL=http://balanca-misturadora:8080

# Cookies: false para http://localhost; true atrás de HTTPS
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000
# Use 127.0.0.1 atrás de Nginx/Caddy; use 0.0.0.0 somente para expor a porta diretamente.
BIND_ADDRESS=0.0.0.0
APP_PORT=3000
